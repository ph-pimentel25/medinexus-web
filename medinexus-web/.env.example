# Public browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=
# Server only. Never prefix these keys with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
# Email (verified sending domain)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# WhatsApp via Twilio (approved templates with variables 1=date, 2=app URL)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_TEMPLATE_REQUESTED=
TWILIO_TEMPLATE_CONFIRMED=
TWILIO_TEMPLATE_REMINDER=
# Optional discovery providers. The model must support Responses structured outputs.
GOOGLE_PLACES_API_KEY=
OPENAI_API_KEY=
OPENAI_SEARCH_MODEL=

# Commission is disabled in the database (platform_commercial_policy).
# Do not add a NEXT_PUBLIC commission flag: clients must never activate billing.
# Online payments: sandbox adapter only. Production settlement/split must be homologated.
PAYMENTS_ENABLED=false
PAYMENT_ENVIRONMENT=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Clinical summaries remain OFF until data-processing terms and clinical review are approved.
CLINICAL_AI_ENABLED=false
OPENAI_CLINICAL_MODEL=
# Reuses OPENAI_API_KEY on the server; store:false is not a Zero Data Retention contract.
